{
  "allowed_modules": [
    "@minecraft/server",
    "@minecraft/server-ui",
    "@minecraft/server-admin",
    "@minecraft/server-net"
  ],
  "module_permissions": {
    "@minecraft/server-net": {
      "allowed_uris": ["http://127.0.0.1:8787/"],
      "force_https": false,
      "max_body_bytes": 8192,
      "max_concurrent_requests": 4
    }
  }
}
